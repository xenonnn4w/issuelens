{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode gzip zstd
  @versioned path /static/build/*
  header @versioned Cache-Control "public, max-age=31536000, immutable"
  @static {
    path /static/* /favicon.svg
    not path /static/build/*
  }
  header @static Cache-Control "public, max-age=0, must-revalidate"
  header @versioned defer Cache-Control "public, max-age=31536000, immutable"
  reverse_proxy api:8080 {
    header_up X-Workspace-Gateway {$GATEWAY_TOKEN}
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }
}

www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}
