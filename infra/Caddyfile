{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode gzip zstd
  @static path /static/* /favicon.svg
  header @static Cache-Control "no-store"
  @review path /api/runs/*/review
  basic_auth @review {
    {$WORKSPACE_USER} {$WORKSPACE_PASSWORD_HASH}
  }
  reverse_proxy api:8080 {
    header_up X-Workspace-Gateway {$GATEWAY_TOKEN}
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }
}

www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}
