DOMAIN=issues.example.com
ACME_EMAIL=you@example.com
WORKSPACE_USER=maintainer
# Generate a Caddy password hash: docker run --rm caddy:2-alpine caddy hash-password
# Single-quote the hash so Docker Compose treats $ characters literally.
WORKSPACE_PASSWORD_HASH='replace-with-bcrypt-hash'
# Generate locally with: openssl rand -hex 32
GATEWAY_TOKEN=replace-with-random-token
# Retrieval-only public runs per UTC day; the shared AI key has a separate one-per-hour limit.
PUBLIC_DAILY_RUN_LIMIT=10
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
